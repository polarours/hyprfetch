pkgname=hyprfetch-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Hyprland-native fetch utility"
arch=("x86_64" "aarch64")
url="https://github.com/polarours/hyprfetch"
license=("MIT")
depends=("gcc-libs" "glibc")
makedepends=("cargo" "git")
optdepends=("hyprland: runtime Hyprland session data")
source=("hyprfetch::git+${url}.git")
sha256sums=("SKIP")

pkgver() {
  cd "$srcdir/hyprfetch"
  local version
  version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)"
  printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/hyprfetch"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/hyprfetch"
  cargo build --release --locked
}

package() {
  cd "$srcdir/hyprfetch"
  install -Dm755 "target/release/hyprfetch" "$pkgdir/usr/bin/hyprfetch"
  install -Dm644 README.md "$pkgdir/usr/share/doc/hyprfetch/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hyprfetch/LICENSE"
}
